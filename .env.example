# ═══════════════════════════════════════════════════════
# KrishiMandi AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════

# ─── MongoDB ──────────────────────────────────────────
MONGO_PASSWORD=KrishiMandi@2024Secure
# If your password contains @, encode it as %40 in connection URLs.
MONGODB_URI=mongodb://krishimandi:KrishiMandi%402024@mongodb:27017/krishimandi?authSource=admin
MONGO_EXPRESS_MONGODB_URL=mongodb://krishimandi:KrishiMandi%402024@mongodb:27017/

# ─── Spring Boot JWT ──────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_A_VERY_LONG_RANDOM_SECRET_STRING_MIN_64_CHARS

# ─── OpenWeatherMap API ───────────────────────────────
# Get free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ─── Mongo Express (admin UI) ─────────────────────────
MONGO_EXPRESS_PASSWORD=adminpassword

# ─── Frontend ─────────────────────────────────────────
VITE_API_URL=http://localhost:8080
VITE_ML_SERVICE_URL=http://localhost:5000

# ─── Anthropic (for Frontend AI) ─────────────────────
# Only needed if running the standalone React artifact
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
